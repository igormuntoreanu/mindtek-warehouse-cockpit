{
	"_version": "1.76.0",
	"sap.app": {
		"id": "mindtek.warehouse.cockpit",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": ["", "en_GB"],
			"fallbackLocale": ""
		},
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}"
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "sap-icon://shipping-status"
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.136.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.ui.layout": {},
				"sap.suite.ui.microchart": {
					"lazy": false
				}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "mindtek.warehouse.cockpit.i18n.i18n",
					"supportedLocales": ["", "en_GB"],
					"fallbackLocale": "",
					"async": true
				}
			}
		},
		"rootView": {
			"viewName": "mindtek.warehouse.cockpit.view.App",
			"type": "XML",
			"async": true,
			"id": "app"
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "mindtek.warehouse.cockpit.view",
				"controlId": "app",
				"controlAggregation": "pages",
				"async": true
			},
			"routes": [
				{
					"name": "cockpit",
					"pattern": "",
					"target": "cockpit"
				},
				{
					"name": "wave",
					"pattern": "wave/{waveId}",
					"target": "cockpit"
				},
				{
					"name": "bin",
					"pattern": "bin/{binId}",
					"target": "cockpit"
				},
				{
					"name": "dock",
					"pattern": "dock/{dockId}",
					"target": "cockpit"
				},
				{
					"name": "worker",
					"pattern": "worker/{workerId}",
					"target": "cockpit"
				}
			],
			"targets": {
				"cockpit": {
					"id": "cockpit",
					"name": "Cockpit",
					"level": 1
				}
			}
		}
	}
}
